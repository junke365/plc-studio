{
  "name": "smart-plc-studio",
  "version": "1.0.0",
  "private": true,
  "description": "智能 PLC IDE - IEC 61131-3 集成开发环境",
  "main": "electron/dist/main.js",
  "author": {
    "name": "PLC Studio"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:editor\"",
    "dev:editor": "npm run dev --workspace=@smart-plc/editor",
    "dev:server": "npm run dev --workspace=@smart-plc/server",
    "build:electron:ts": "tsc -p electron/tsconfig.json",
    "rebuild:native": "electron-rebuild -f -w serialport -w better-sqlite3",
    "dev:electron": "concurrently \"npm run dev:server\" \"npm run dev:editor\" \"wait-on http://localhost:5173 && npm run build:electron:ts && cross-env ELECTRON_DEV=true electron ./electron/dist/main.js\"",
    "build": "npm run build --workspaces",
    "build:shared": "npm run build --workspace=@smart-plc/shared",
    "build:plc-core": "npm run build --workspace=@smart-plc/plc-core",
    "build:editor": "npm run build --workspace=@smart-plc/editor",
    "build:server": "npm run build --workspace=@smart-plc/server",
    "build:server:bundle": "esbuild packages/server/src/main.ts --bundle --platform=node --format=cjs --packages=external --alias:@smart-plc/shared=./packages/shared/dist/index.js --alias:@smart-plc/plc-core=./packages/plc-core/dist/index.js --outfile=packages/server/dist-server/main.cjs",
    "build:electron": "npm run build:electron:ts && npm run build:shared && npm run build:plc-core && npm run build:server && npm run build:server:bundle && npm run build:editor && electron-builder",
    "pack:mac": "npm run build:electron -- --mac",
    "pack:linux": "npm run build:electron -- --linux",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "clean": "rimraf node_modules packages/*/node_modules packages/*/dist"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/websocket": "^9.0.0",
    "@serialport/parser-readline": "^13.0.0",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.0",
    "glob": "^10.3.10",
    "serialport": "^13.0.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "winston": "^3.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@monaco-editor/loader": "^1.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.11.5",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vueuse/core": "^10.7.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "fabric": "^5.3.0",
    "naive-ui": "^2.37.3",
    "nodemon": "^3.0.3",
    "pinia": "^2.1.7",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "three": "^0.160.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "wait-on": "^7.2.0"
  }
}
