          { "name": "AiChannel3", "type": "INT", "className": "Input", "comment": "模拟量通道3（流量）" },
          { "name": "EnableScaling", "type": "BOOL", "className": "Input", "comment": "使能缩放" },
          { "name": "ResetAlarm", "type": "BOOL", "className": "Input", "comment": "报警复位" }
        ],
        "outputVars": [
