          { "name": "PressPrev", "type": "REAL", "className": "Local", "comment": "上次压力值" },
          { "name": "FilterAlpha", "type": "REAL", "className": "Local", "initialValue": 0.3, "comment": "滤波系数" },
          { "name": "TempHighLatch", "type": "BOOL", "className": "Local", "comment": "温度高报警锁存" },
          { "name": "TempLowLatch", "type": "BOOL", "className": "Local", "comment": "温度低报警锁存" },
          { "name": "PressHighLatch", "type": "BOOL", "className": "Local", "comment": "压力高报警锁存" },
          { "name": "PressLowLatch", "type": "BOOL", "className": "Local", "comment": "压力低报警锁存" },
          { "name": "FlowLowLatch", "type": "BOOL", "className": "Local", "comment": "流量低报警锁存" },
          { "name": "AoOutputRaw", "type": "INT", "className": "Local", "comment": "模拟量输出原始值" }
        ],
        "inOutVars": [], "tempVars": [], "globalVars": [], "externalVars": [], "accessVars": []
      },
