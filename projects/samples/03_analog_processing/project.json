          { "name": "FlowRate", "type": "REAL", "className": "Output", "comment": "流量工程值（L/min）" },
          { "name": "TempHighAlarm", "type": "BOOL", "className": "Output", "comment": "温度高报警" },
          { "name": "TempLowAlarm", "type": "BOOL", "className": "Output", "comment": "温度低报警" },
          { "name": "PressHighAlarm", "type": "BOOL", "className": "Output", "comment": "压力高报警" },
          { "name": "PressLowAlarm", "type": "BOOL", "className": "Output", "comment": "压力低报警" },
          { "name": "FlowLowAlarm", "type": "BOOL", "className": "Output", "comment": "流量低报警" },
          { "name": "SystemFault", "type": "BOOL", "className": "Output", "comment": "系统故障" },
          { "name": "AoChannel1", "type": "INT", "className": "Output", "comment": "模拟量输出通道" }
